rader.com/variants/g7NpMsgmg8KY2o3kQhyHnaok/0614d84bdc59a9966ecae828cdf598d52b24aff775161cff6edd2989d8b52400/0.jpg"}],["fashion",{"thumbnailUrl":"https://media.cgtrader.com/variants/reBB2VdPi8N5gi8zbHUZfS2w/0614d84bdc59a9966ecae828cdf598d52b24aff775161cff6edd2989d8b52400/16-fashion-girls-scan-vol-2-3d-model-low-poly-obj-fbx.jpg"}]],"seo_tags":null,"is_mobile_s_s_r":false,"data":[{"id":"6989320","type":"listingItem","attributes":{"id":6989320,"title":"World Cup 2026 Stadiums - USA","price":800.0,"description":"11 stadiums\n-Lumen Field\n-Levi's Stadium\n-SoFi Stadium\n-Arrowhead Stadium\n-At\u0026t Stadium\n-Mercedes Benz Stadium\n-NRG Stadium\n-Gillette Stadium\n-Lincoln Financial Field\n-Hard Rock Stadium\n-MetLife Stadium","imageAlt":"3D World Cup 2026 Stadiums - USA cup","url":"https://www.cgtrader.com/3d-model-packs/world-cup-2026-stadiums-usa-e780dbf4-e02b-44ee-9d7d-0dc5ccc21c33","isCLDApplicable":false,"isSaleOffApplicable":true,"gaAttributes":{},"primaryImage":{"gridFallbackUrl":"https://media.cgtrader.com/variants/wjo5ugu8n9pj33g6v6r1ezhqp9oi/a26e47dab5f2d22c43d6c5ce4b4b46ecc30c70918878397cba1a10c1e35d7bfc/EEUU%20stadiums%20Miniatura.jpg","gridUrl":"https://media.cgtrader.com/variants/wjo5ugu8n9pj33g6v6r1ezhqp9oi/78add9c2f02fbd73a43ffb3970be38683c5f15eff6ca849dc78c644f4ff9ce1b/EEUU%20stadiums%20Miniatura.webp","isAdultContent":false},"modelInfo":{"modelUrl":"https://www.cgtrader.com/3d-model-packs/world-cup-2026-stadiums-usa-e780dbf4-e02b-44ee-9d7d-0dc5ccc21c33","isCgtVerified":false,"types":{"printReady":false,"animated":false,"pbr":false,"rigged":false,"lowPoly":false}},"metaverseFormatsList":[],"categorySlug":"architectural","subcategorySlug":"other","categoryTitle":"Architectural","subcategoryTitle":"Other","schemaImageUrl":"https://img-new.cgtrader.com/items/6989320/19be71f525/world-cup-2026-stadiums-usa-3d-model-19be71f525.webp","saleOffDiscount":50,"eligibleForSubscription":false,"subscriptionSubscribed":false,"subscriptionPotential":false}},{"id":"3445726","type":"listingItem","attributes":{"id":3445726,"title":"Lemon","price":36.4,"description":"You will receive 5 × photorealistic digital lemons (1x full/ 2× halves/ 1x slice/ 1x quarter) with 8k texture maps. \nEach has been scanned with 300+ photos and digitalized with a photogrammetry software. \nIt has organized non-overlapping uv`s and a decent topology which supports further editing and a lot of detail. \nWith the 3D model (formats: fbx, obj) there is a diffuse, roughness, displacement, sss, RGB mask and normal map.\n\n- Model Formats: OBJ / FBX\n- Model Details: Subdivision-ready / organized non-overlapping uv`s\n- Texture Maps: Diffuse / Roughness / Normal / Displacement/ SSS/ RGB mask\n- Texture Resolution: 8192x8192px\n\nThe lights, cameras, and  background  are not included in the product.\nThe model is clean and centred at the origin with real-world scale.","imageAlt":"3D model tree Lemon","url":"https://www.cgtrader.com/3d-models/food/fruit/lemon-d0c1c06d-d751-415b-8313-aa0dfac557bb","isCLDApplicable":false,"isSaleOffApplicable":true,"gaAttributes":{},"primaryImage":{"gridFallbackUrl":"https://media.cgtrader.com/variants/df4HQfS1UUNsS3qPg76d1ymr/a26e47dab5f2d22c43d6c5ce4b4b46ecc30c70918878397cba1a10c1e35d7bfc/lemon_preview_00.jpg","gridUrl":"https://media.cgtrader.com/variants/df4HQfS1UUNsS3qPg76d1ymr/78add9c2f02fbd73a43ffb3970be38683c5f15eff6ca849dc78c644f4ff9ce1b/lemon_preview_00.webp","isAdultContent":false},"modelInfo":{"modelUrl":"https://www.cgtrader.com/3d-models/food/fruit/lemon-d0c1c06d-d751-415b-8313-aa0dfac557bb","isCgtVerified":false,"types":{"printReady":false,"animated":false,"pbr":true,"rigged":false,"lowPoly":false}},"metaverseFormatsList":[{"id":5,"name":".fbx","is_native":false},{"id":12,"name":".obj","is_native":false}],"categorySlug":"food","subcategorySlug":"fruit","categoryTitle":"Food","subcategoryTitle":"Fruit","schemaImageUrl":"https://img-new.cgtrader.com/items/3445726/4eef153935/lemon-3d-model-4eef153935.webp","saleOffDiscount":30,"eligibleForSubscription":false,"subscriptionSubscribed":false,"subscriptionPotential":false}},{"id":"3719028","type":"listingItem","attributes":{"id":3719028,"title":"ARCHITECTURAL KITBASH - VOL 01 - 02 - 03 - 04 - 05","price":43.0,"description":"This collection includes 4 Architectural Kitbash products:\n\n**1. 150 ARCHITECTURAL KITBASH - VOL 01**\n\n**2. 407 ARCHITECTURAL KITBASH - VOL 02**\n\n**3. 160 ARCHITECTURAL KITBASH - VOL 03**\n\n**4. 180 ARCHITECTURAL KITBASH - VOL 04**\n\n**5. 140 CORNER ARCHITECTURAL KITBASH - VOL 05**\n\nThis mega pack includes **1037 architectural kitbash** in various shapes and styles.\n\nAll products include **different categories for architecture, woodcarving, or any other modeling subjects**.\n\n\nAll models are **Carefully designed** and have a correct mesh (quad) and **Turbosmooth not collapsed** so you can access their base mesh.\n\nEach products have a **PDF  catalogue** to preview the models.\n\n","imageAlt":"ARCHITECTURAL KITBASH - VOL 01 - 02 - 03 - 04 - 3D model","url":"https://www.cgtrader.com/3d-model-packs/architectural-kitbash-vol-1-and-2","isCLDApplicable":false,"isSaleOffApplicable":true,"gaAttributes":{},"primaryImage":{"gridFallbackUrl":"https://media.cgtrader.com/variants/ctFU8s64dUgGGnsAZMLQqZ5R/a26e47dab5f2d22c43d6c5ce4b4b46ecc30c70918878397cba1a10c1e35d7bfc/Cgtrader%20poster-Collection.jpg","gridUrl":"https://media.cgtrader.com/variants/ctFU8s64dUgGGnsAZMLQqZ5R/78add9c2f02fbd73a43ffb3970be38683c5f15eff6ca849dc78c644f4ff9ce1b/Cgtrader%20poster-Collection.webp","isAdultContent":false},"modelInfo":{"modelUrl":"https://www.cgtrader.com/3d-model-packs/architectural-kitbash-vol-1-and-2","isCgtVerified":false,"types":{"printReady":false,"animated":false,"pbr":false,"rigged":false,"lowPoly":false}},"metaverseFormatsList":[],"categorySlug":"architectural","subcategorySlug":"decoration","categoryTitle":"Architectural","subcategoryTitle":"Decoration","schemaImageUrl":"https://img-new.cgtrader.com/items/3719028/a6ae212f3a/architectural-kitbash-vol-01-02-03-04-05-3d-model-a6ae212f3a.webp","saleOffDiscount":30,"eligibleForSubscription":false,"subscriptionSubscribed":false,"subscriptionPotential":false}},{"id":"3725179","type":"listingItem","attributes":{"id":3725179,"title":"Orange","price":36.4,"description":"You will receive 5 × photorealistic digital oranges (1x full/ 2× halves/ 1x slice/ 1x quarter) with 8k texture maps. It has organized non-overlapping uv`s and a decent topology which supports further editing and a lot of detail. With the 3D model (formats: fbx, obj) there is a diffuse, roughness, displacement, sss, RGB mask and normal map.\n\n- Model Formats: OBJ / FBX\n- Model Details: Subdivision-ready / organized non-overlapping uv`s\n- Texture Maps: Diffuse / Roughness / Normal / Displacement/ SSS/ RGB mask\n- Texture Resolution: 8192x8192px\n\nThe lights, cameras, and background are not included in the product. The model is clean and centred at the origin with real-world scale.","imageAlt":"3D Orange fruit realistic-orange","url":"https://www.cgtrader.com/3d-models/food/fruit/orange-9a20ab50-965c-490c-a76c-d5695a606f33","isCLDApplicable":false,"isSaleOffApplicable":true,"gaAttributes":{},"primaryImage":{"gridFallbackUrl":"https://media.cgtrader.com/variants/Mj4Pe7AwPodtMf45s7JQvKu6/a26e47dab5f2d22c43d6c5ce4b4b46ecc30c70918878397cba1a10c1e35d7bfc/orange_preveiw_00.jpg","gridUrl":"https://media.cgtrader.com/variants/Mj4Pe7AwPodtMf45s7JQvKu6/78add9c2f02fbd73a43ffb3970be38683c5f15eff6ca849dc78c644f4ff9ce1b/orange_preveiw_00.webp","isAdultContent":false},"modelInfo":{"modelUrl":"https://www.cgtrader.com/3d-models/food/fruit/orange-9a20ab50-965c-490c-a76c-d5695a606f33","isCgtVerified":false,"types":{"printReady":false,"animated":false,"pbr":true,"rigged":false,"lowPoly":false}},"metaverseFormatsList":[{"id":5,"name":".fbx","is_native":false},{"id":12,"name":".obj","is_native":false}],"categorySlug":"food","subcategorySlug":"fruit","categoryTitle":"Food","subcategoryTitle":"Fruit","schemaImageUrl":"https://img-new.cgtrader.com/items/3725179/080d34232a/orange-3d-model-080d34232a.webp","saleOffDiscount":30,"eligibleForSubscription":false,"subscriptionSubscribed":false,"subscriptionPotential":false}},{"id":"6694790","type":"listingItem","attributes":{"id":6694790,"title":"City Characters","price":259.0,"description":"**KEY HIGHLIGHTS**  \n\nThe pack includes 300 prepared 3D characters of various ages, body types, and skin tones, 1100+ clothing assets, customization tool, movement controller, animations, facial expressions, 100+ props, animals, icons.         \n\n### **KEY FEATURES**  \n\n- **Demo Scene** includes 300 unique 3D characters: 90 professionals and 210 everyday citizens. All clothing items are separate 3D models, allowing you to replace, remove, or mix them freely. Characters cover multiple age groups and body types: Adult, Plus-size, Pumped, Senior, Teen, and Child.     \nEach character has an individual index number, making it easy to locate any model.    \n- **Character Customization** tool allows you to quickly and easily generate a character based on selected parameters. Choose the body type, asset categories that will be included in the generation, and instantly see the final result!     \n- **1100 Unique Assets.** The pack includes 1100 unique clothing assets created specifically for different body types and both genders - each item is truly unique and not shared across character categories, ensuring maximum visual variety. For example, a leopard-print tank top exists only for one specific character type and is not duplicated for others. Assets are organized into categories such as hats, hairstyles, glasses, tank tops, shirts, sweaters, jackets, coats, blazers, suits, pants, skirts, shorts, shoes, gloves, jewelry, bags, backpacks, and other wardrobe elements, providing a deeply customizable and diverse appearance for every character.    \n- **Movement Controller.** Start the game mode and use WASD to move the model.      \n- **Animations.** The pack includes over 150 unique thematic animations, such as walking, running, sitting, relaxing, talking, gesturing, interacting with objects, taking photos, using a phone, drinking, eating, waving, shopping, and many more everyday actions. You can also freely use animations from the Mixamo library, which offers more than 2600 additional animations to further expand and customize character behavior.     \n- **Icons.** All demo characters and assets have icons.     \n- **Animals.** The pack includes 13 animal models - several dog breeds and stylized cats, each provided with multiple color variations and a full set of animations.     \n- **Ease of Use.** The pack includes two files with different Unity versions, and in each one, the scene is set up in three render pipelines. Simply download the version you need and open the scene in your preferred render pipeline. Everything is clear and easy to use.        \n- **Optimized Models.** Each model is designed with a limited number of textures, an optimized mesh, and simple shaders, ensuring smooth performance across mobile devices, VR/AR, PCs, and consoles. With these assets, your project will maintain excellent performance while delivering stunning visuals.    \n- **Support.** Free updates and technical support available in our Discord.      \n\n---  \n\n### **DEMO SCENE**    \n**300 unique animated characters.**        \n- **90 professional character models:**    \nThere may be more than one model per profession, so the list contains fewer than 90 unique titles.    \nActor, Architect, Artist, Basketball PL, Bicyclist, Builder, Businessman, Businesswoman, Captain, Cashier, Cleaner, Cook, Courier, Dealer, Doctor, EMT, Farmer, Firefighter, Football PL, Gardener, Garbageman, Hairdresser, Housemaid, Patient, Policeman, Prisoner, Repairman, Saver, Security, Stewardess, Swimmer, Teacher, Waiter, Waitress.    \n\n- **210 city character models:**    \nFashionable Characters - men and women in bright, trendy outfits: printed shirts, dresses, colorful suits, stylish jackets, hats, blazers, and accessories.    \nCasual City Residents - characters in everyday urban clothing: T-shirts, sweatshirts, jeans, leggings, shorts, sundresses, skirts, hoodies, and various jackets.     \nBeach \u0026 Vacation Characters - people in beachwear: swimsuits, swimming trunks, shorts, light shirts, hats, and summer accessories.      \nFestive \u0026 Themed Outfits - characters in unusual and themed clothing: costumes, unique hats, festive sets, and expressive looks.     \nClassically Dressed Characters - characters in more elegant and neat outfits: dresses, shirts, blazers, trousers, long coats, and trench coats.   \nCold-Climate Residents - characters in warm clothing: down jackets, coats, hats, scarves, and winter boots.    \nSummer Outfits - characters in lightweight clothing: T-shirts, tank tops, shorts, summer dresses, and light footwear.    \nUnique Stylish Characters - distinctive and bold outfits: hats, unconventional color combinations, creative silhouettes, and fashion accents.      \n\n### **ANIMATIONS**    \n**The pack includes over 150 unique thematic animations**, such as walking, running, sitting, relaxing, talking, gesturing, interacting with objects, taking photos, using a phone, drinking, eating, waving, shopping, and many more everyday actions.      \nYou can also use animations from Mixamo, which offers more than 2,600 unique animations.       \n\n### **1100 UNIQUE CLOTHING ASSETS**  \nHair - various hairstyles, including headwear-compatible options.   \nFacial Hair - beards and mustaches.    \nHeadwear - hats, caps, beanies, and themed accessories.    \nGlasses \u0026 Masks - sunglasses, everyday glasses, and decorative masks.     \nJewelry.    \nBackpacks \u0026 Bags - models for different character styles.    \nGloves - regular, insulated, and stylized variants.     \nFootwear - sneakers, boots, dress shoes, sandals, and winter footwear.     \nCostumes \u0026 Outfit Sets - everyday clothing and professional outfits.     \nOuterwear - jackets, hoodies, puffer jackets, and coats.     \nShirts \u0026 Tops - shirts, polos, blouses, Hawaiian shirts, T-shirts, and tank tops.     \nBlazers \u0026 Jackets - blazers, tuxedos, and vests.     \nDresses - casual, evening, asymmetrical, and fitted styles.     \nBottoms - pants, trousers, shorts, and skirts.     \n\nAll clothing assets are optimized for mixing and matching, enabling easy customization and strong visual variety.      \n\n**100 PROPS**     \nThe pack includes a wide selection of interactive props organized into convenient categories:      \nEveryday items, travel and outdoor accessories, sports equipment, tools, kitchen utensils, art and office supplies, as well as various miscellaneous props.     \nAll items are designed to enhance scenes, animations, and character interactions.    \n\n**ANIMALS**    \n\nDogs 2 variants    \nDoberman , Labrador, Dachshund , Pomeranian , Pomeranian Puppy    \nDog animations: Idle, Walk, Run, Sit, Lie, Lie_Sleep, Lie_Happy, AskToPlay, GivePaw, Flip, Turn, Bark     \n\nCats     \nBlack Cat, White Cat, Ginger Cat    \nCat animations: Idle, Walk, Run, Sit, Stretch, Breathing      \n\n---  \n### **COMPATIBLE 3D MODEL PACKS**  \nThese packs will look great together:   \nMegacity - https://www.cgtrader.com/3d-models/exterior/cityscape/megacity      \nInterior - https://www.cgtrader.com/3d-models/furniture/furniture-set/cute-furniture-low-poly-asset-pack-by-ithappy       \n \n### **FILES**       \nYou’ll be able to download formats such as Unity Package, UE, Blender, C4D, Maya, 3DSMax, FBX, OBJ, GLTF, and STL.      \n\n### **COMPATIBILITY**  \n\n- Blender 3.6+   \n- Unity 2021.3+    \n- Unity 6000+      \n- Unreal Engine 4.20+   \n- Unreal Engine 5.0+   \n- Godot Engine 3.4+   \n\n---  \n\n### **TECHNICAL INFO**  \n\n- **Geometry:**    \n   - 1400 Unique Assets      \n   - 1.550k triangles all pack       \n   - The body model of the character has 3.5k tris.    \n   - A character model with a costume has an average of 8k tris.    \n\n- **Scale:** Real-world-size      \n- **Character Animations:**  Yes (150 unique animations)        \n- **Materials:** All models use 24 materials      \n- **Textures:** All models use 23 textures     \n\n---  \n\n### **SUPPORT**   \n\nFree updates and technical support: https://discord.com/invite/jxrQM8hXnd  \n\nWe would love to hear from you: support@ithappystudios.com    \nWe aim to respond within 24 hours.  \n\n*Leave a review to help us improve and expand this character pack further! Your projects are the reason we create 3D models. We genuinely care about how you use our work, and we'd love to hear your thoughts on the pack.*  \n\n---  \n\n### **FOLLOW US**  \n\nNew packs coming out, updates, promotions, tutorials:  \nDISCORD - https://discord.com/invite/jxrQM8hXnd  \nYOUTUBE - https://www.youtube.com/@ithappystudios","imageAlt":"City Characters 3D asset","url":"https://www.cgtrader.com/3d-models/character/human-anatomy/city-characters","isCLDApplicable":false,"isSaleOffApplicable":true,"gaAttributes":{},"primaryImage":{"gridFallbackUrl":"https://media.cgtrader.com/variants/x1bfn246qx7ebingei9ebrfwcou2/a26e47dab5f2d22c43d6c5ce4b4b46ecc30c70918878397cba1a10c1e35d7bfc/CGT%20City_Characters.jpg","gridUrl":"https://media.cgtrader.com/variants/x1bfn246qx7ebingei9ebrfwcou2/78add9c2f02fbd73a43ffb3970be38683c5f15eff6ca849dc78c644f4ff9ce1b/CGT%20City_Characters.webp","isAdultContent":false},"modelInfo":{"modelUrl":"https://www.cgtrader.com/3d-models/character/human-anatomy/city-characters","isCgtVerified":false,"types":{"printReady":false,"animated":true,"pbr":true,"rigged":true,"lowPoly":true}},"metaverseFormatsList":[{"id":83,"name":".unitypackage","is_native":true},{"id":21,"name":".blend","is_native":false},{"id":215,"name":".png","is_native":false},{"id":null,"name":null,"is_native":false},{"id":216,"name":".jpg","is_native":false},{"id":6,"name":".c4d","is_native":false},{"i